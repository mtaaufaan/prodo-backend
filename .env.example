# ============================================================
# PRODO Backend — Environment Variables
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke git.
# ============================================================

# Server
APP_ENV=development
SERVER_PORT=3001
SHUTDOWN_TIMEOUT=30s

# Database (PostgreSQL 16)
DATABASE_URL=postgres://prodo:prodo_dev_secret@localhost:5432/prodo_dev?sslmode=disable

# Database pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Redis
REDIS_URL=redis://:redis_dev_secret@localhost:6379/0

# Keycloak OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/PRODO
KEYCLOAK_AUDIENCE=prodo-backend

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=prodo
MINIO_SECRET_KEY=prodo_minio_secret
MINIO_BUCKET=prodo-attachments
MINIO_USE_SSL=false

# OpenBao / Vault (opsional untuk dev lokal — biarkan kosong jika pakai .env.local)
VAULT_ADDR=
VAULT_TOKEN=

# Asynq
ASYNQ_CONCURRENCY=10

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173

# OpenTelemetry -- otel-collector, S0-15. Format host:port (bukan URL).
# Kosongkan untuk nonaktifkan tracing. Default dev: localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry/GlitchTip -- S0-17. Kosongkan untuk nonaktifkan error tracking.
# Dev: buat project di GlitchTip (http://localhost:8000), salin DSN-nya ke sini.
SENTRY_DSN=
