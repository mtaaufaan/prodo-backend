# ============================================================
# PRODO Backend — Environment Variables
# Salin file ini ke .env.local dan isi nilainya.
# JANGAN commit .env.local ke git.
# ============================================================

# Server
APP_ENV=development
SERVER_PORT=3001
SHUTDOWN_TIMEOUT=30s

# Database (PostgreSQL 16)
# DATABASE_URL: superuser, HANYA untuk migrate CLI/seed (make db.migrate/db.seed).
DATABASE_URL=postgres://prodo:prodo_dev_secret@localhost:5432/prodo_dev?sslmode=disable
# APP_DATABASE_URL: role prodo_app_user (non-superuser, kena RLS -- S2-10),
# dipakai runtime API server. Role dibuat oleh migration
# 20260823090000_rls_app_role -- jalankan migrate dulu sebelum start server.
APP_DATABASE_URL=postgres://prodo_app_user:prodo_app_dev_secret@localhost:5432/prodo_dev?sslmode=disable

# Database pool
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Redis
REDIS_URL=redis://:redis_dev_secret@localhost:6379/0

# Keycloak OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/PRODO
KEYCLOAK_AUDIENCE=prodo-backend

# Keycloak Admin REST API (service account client_credentials, S1-03) --
# client "prodo-backend-admin" di infra/keycloak/realm-PRODO.json
KEYCLOAK_ADMIN_CLIENT_ID=prodo-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

# SMTP (Mailpit di dev, S1-04) -- tanpa auth, kosongkan SMTP_USER/SMTP_PASS
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@prodo.local
SMTP_USER=
SMTP_PASS=

# Frontend origin -- dipakai menyusun activation link di email (S1-04)
APP_BASE_URL=http://localhost:5173

# Passphrase enkripsi pgcrypto untuk totp_secret (S1-06) -- WAJIB diisi
# nilai acak yang kuat, jangan pernah commit nilai dev/prod aslinya
MFA_ENCRYPTION_KEY=

# MinIO (Object Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=prodo
MINIO_SECRET_KEY=prodo_minio_secret
MINIO_BUCKET=prodo-attachments
MINIO_USE_SSL=false

# OpenBao / Vault (opsional untuk dev lokal — biarkan kosong jika pakai .env.local)
VAULT_ADDR=
VAULT_TOKEN=

# Asynq
ASYNQ_CONCURRENCY=10

# CORS
CORS_ALLOW_ORIGINS=http://localhost:5173

# OpenTelemetry -- otel-collector, S0-15. Format host:port (bukan URL).
# Kosongkan untuk nonaktifkan tracing. Default dev: localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# Sentry/GlitchTip -- S0-17. Kosongkan untuk nonaktifkan error tracking.
# Dev: buat project di GlitchTip (http://localhost:8000), salin DSN-nya ke sini.
SENTRY_DSN=
